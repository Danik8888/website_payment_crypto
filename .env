# Bitcoin Core RPC настройки
BTC_RPC_USER=-
BTC_RPC_PASSWORD=-
BTC_RPC_HOST=127.0.0.1
BTC_RPC_PORT=8332  # 18332 = testnet, 8332 = mainnet, 18443 = regtest
BTC_WALLET=- # имя кошелька в Bitcoin Core (оставьте пустым, если один кошелек)

# Цена товара в рублях (фиксированная)
# Курс BTC/RUB получается автоматически с CoinGecko API
PRICE_RUB=-

# Поддержка (username без @)
SUPPORT_USERNAME=-

# Секретный ключ Flask 
SECRET_KEY=-

# Администраторы (username без @, через запятую для нескольких)
ADMIN_USERNAMES=-,-

# Пароль для входа в админ-панель
ADMIN_PASSWORD=-
